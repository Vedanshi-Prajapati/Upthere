    "Insights are UpThere's interpretation of forecast data and may change as forecasts update. For official warnings, refer to your national weather service.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insights are UpThere's interpretation of forecast data and may change as forecasts update. For official warnings, refer to your national weather service."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनसाइट्स पूर्वानुमान डेटा की व्याख्या हैं और अपडेट के साथ बदल सकती हैं। आधिकारिक चेतावनियों के लिए अपनी राष्ट्रीय मौसम सेवा देखें।"
          }
        }
      }
    },
